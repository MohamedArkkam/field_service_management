# Local PostgreSQL (matches docker-compose.yml) — copy to .env if needed; never commit .env
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sitedirect
POSTGRES_USER=sitedirect
POSTGRES_PASSWORD=sitedirect

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sitedirect
SPRING_DATASOURCE_USERNAME=sitedirect
SPRING_DATASOURCE_PASSWORD=sitedirect

# JWT / seed (dev defaults also in application.yml)
SITEDIRECT_JWT_SECRET=sitedirect-dev-secret-change-me-use-at-least-32-bytes!!
SITEDIRECT_ADMIN_EMAIL=admin@sitedirect.local
SITEDIRECT_ADMIN_PASSWORD=Admin123!
